{

   "write_folder_sim":"/home/ihuarte/Escritorio/Ivan/NNs/pruebas/",

   "callback":{
        "keeper": true,
        "energy_plot": false,
        "modphase": false,
        "sanity": false,
        "checkpoint":true,
        
        "keeper_setup":{
            "baseline": 1e-8,
            "mode": "best_energy"
        },        
        "modphase_setup": {
            "plot_each": 10,
            "no_null_mod": false,
            "logscale": false
        },
        "sanity_setup":{
            "do_each": 500,
            "mode": "simple",
            "verbose": 3,
            "metrics": {
                "gradients": true,
                "sampling":  true,
                "phase":     true
            }
        },
        "checkpoint_setup":{
            "do_each":200,
            "async": false
        }
            
    },

    "sampler":{
        "sampler":{
            "rules": ["LocalRule", "Exchange", "InvertMagnetization"],
            "prules": [0.2, 0.7, 0.1]
        },
        "n_ranks": 1,
        "n_chains_per_rank": 32,
        "n_samples_per_chain": 32,
        "chunk_sampler": null,
        "chunk_vstate": 1024
    },

    "schedule":{

        "learning_rate":{
            "epochs_struct":[
                [ 
                    [50, 5000]
                ]
            ],

            "modes_struct":[
                [
                    [ ["0", "1"], ["0", "1"] ]
                ]
            ],
            "lr_struct":[
                [  
                    [ ["lin(0.00002,0.05)", "lin(0.00001,0.05)"], ["exp(0.05,0.002,5)", "exp(0.05,0.001,5)"] ]
                ]
            ],
            "repeat":[], 
            "rescale": 1.0
        },
        
        "sampler":{

        }
    
    }


}


