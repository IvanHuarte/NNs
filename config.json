{

   "write_folder_sim":"/home/ihuarte/Escritorio/Ivan/NNs/pruebas/",

   "callback":{
        "keeper": true,
        "inline": false,
        "modphase": false
   },

    "explore_mode": true,

    "sampler":{
        "sampler":{
            "rules": ["LocalRule"],
            "prules": [0.75, 0.25]
        },
        "n_ranks": 1,
        "n_chains_per_rank": 16,
        "n_samples_per_chain": 64,
        "chunk_sampler": null,
        "chunk_vstate": 512
    },

    "split_training": true,

    "normal_schedule":{
        "lr_name": "warmup_exponential_decay",

        "setup":{
            "total_epochs": 500
        },

        "lr_schedules":{
            "warmup_exponential_decay":{
                "lr0": 0.001,                 
                "peak_value": 0.05,
                "warmup_steps": 50,
                "decay_rate": 0.991
            },

            "exp_cos_schedule":{
                "lr0":0.3,          
                "decay_exp":1.0,
                "cosine_cycles": 2,
                "n":0.1,
                "lr_min": 0.01
            }
        }
    },

    "ST_schedule":{
        "lr_name":"segment",
        "setup":{
            "segments":[
                [10,10,10,10,10,10],
                [100]
            ],
            "mode":[
                ["M","P","M","P","M","P"],
                ["P"]
            ],
            "repeat_segment":[20, 1]
        },

        "lr_schedules":{
            "stairs_schedule":{
                "lr0": 0.1,
                "lr_min": 0.00001
            },

            "segment":{
                "lr":[
                    0.08, 0.06, 0.04, 0.02, 0.01, 
                    0.005,0.0005, 0.0001, 0.00005, 0.00001, 
                    0.000005, 0.000001, 0.0000005, 0.00000005, 0.000000005,
                    0.0000000005, 0.00000000005, 0.000000000005, 0.000000000001, 0.0000000000005,
                    0.1
                    
                ]
            }
        }
    }

}


