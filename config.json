{

   "write_folder_sim":"/home/ihuarte/Escritorio/Ivan/NNs/pruebas_clasificador/CvT3_1S64_CLSF_64_lr0.01/",    "sim <---> SSF":"Ruta donde se guardan los productos de simulaciones",
    

    "exact_diagonalization": true,
    "dump_sim_callback": true,
    "explore_mode": true,


    "sampler":{
        "n_ranks": 1,
        "n_chains_per_rank": 16,
        "n_samples_per_chain": 64,
        "chunk_sampler": null,
        "chunk_vstate": 512
    },

    "split_training": true,

    "normal_schedule":{
        "lr_name": "warmup_exponential_decay",

        "setup":{
            "total_epochs": 300

        },

        "lr_schedules":{
            "warmup_exponential_decay":{
                "lr0": 0.5,                 
                "peak_value": 1.0,
                "warmup_steps": 50,
                "decay_rate": 0.992
            },

            "exp_cos_schedule":{
                "lr0":0.3,          
                "decay_exp":1.0,
                "cosine_cycles": 2,
                "n":0.1,
                "lr_min": 0.01
            }
        }
    },

    "ST_schedule":{
        "lr_name":"stairs_schedule",
        "setup":{
            "segments":[[25,25,25]],
            "mode":[["P", "M","B"]],
            "repeat_segment":[15]
        },

        "lr_schedules":{

            "stairs_schedule":{
                "lr0": 0.01,
                "lr_min": 0.00001
            },

            "segment":{
                "lr":[
                    0.1, 0.01, 0.005,
                    0.001, 0.0005, 0.0001
                ]
            }
        }

    }

}
