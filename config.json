{

   "write_folder_sim":"/home/ihuarte/Escritorio/Ivan/NNs/new_pruebas/",

   "callback":{
        "keeper": true,
        "inline":   false,
        "modphase": true,
        "sanity": false,
        "sanity_setup":{
            "do_each": 100,
            "mode": "simple",
            "verbose": 3,
            "metrics": {
                "gradients": true,
                "sampling":  true,
                "phase":     true
            }
        }
            
    },

    "explore_mode": true,

    "sampler":{
        "sampler":{
            "rules": ["LocalRule", "InvertMagnetization"],
            "prules": [0.8, 0.2]
        },
        "n_ranks": 1,
        "n_chains_per_rank": 32,
        "n_samples_per_chain": 64,
        "chunk_sampler": null,
        "chunk_vstate": 512
    },

    "split_training": true,

    "ST_schedule":{
        "epochs_struct":[
            [ 
                [50], [300], [1000], [500]
            ]
        ],

        "modes_struct":[
            [ 
                [["A"]], [[1]], ["A"], ["A"]
            ]
        ],
        "lr_struct":[

            [  
                [[0.01]], [[0.1]], [["exp(0.1, 0.0001)", "exp(0.4, 0.0005)"]], [[0.0001]]
            ]
        ],
        "repeat":[],
        "rescale": 0.5
}

}


