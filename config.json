{

   "write_folder_sim":"/home/ihuarte/Escritorio/Ivan/NNs/pruebas_refinement/",

   "callback":{
        "keeper": true,
        "inline": true,
        "modphase": true
   },

    "explore_mode": true,

    "sampler":{
        "sampler":{
            "rules": ["LocalRule", "InvertMagnetization"],
            "prules": [0.75, 0.25]
        },
        "n_ranks": 1,
        "n_chains_per_rank": 16,
        "n_samples_per_chain": 64,
        "chunk_sampler": null,
        "chunk_vstate": 512
    },

    "split_training": true,

    "normal_schedule":{
        "lr_name": "warmup_exponential_decay",

        "setup":{
            "total_epochs": 500
        },

        "lr_schedules":{
            "warmup_exponential_decay":{
                "lr0": 0.001,                 
                "peak_value": 0.05,
                "warmup_steps": 50,
                "decay_rate": 0.991
            },

            "exp_cos_schedule":{
                "lr0":0.3,          
                "decay_exp":1.0,
                "cosine_cycles": 2,
                "n":0.1,
                "lr_min": 0.01
            }
        }
    },

    "ST_schedule":{
        "lr_name":"segment",
        "setup":{
            "segments":[
                [50,50,50,50,50,50,50,50,50,50]
            ],
            "mode":[
                ["P","M","P","M","P","M","P","M","P","M"]
            ],
            "repeat_segment":[1]
        },

        "lr_schedules":{
            "stairs_schedule":{
                "lr0": 0.1,
                "lr_min": 0.00001
            },

            "segment":{
                "lr":[
                    
                     0.01, 0.1
                    
                ]
            }
        }
    }

}


