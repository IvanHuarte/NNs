{

   "write_folder_sim":"/home/ihuarte/Escritorio/Ivan/NNs/new_pruebas/",

   "callback":{
        "keeper": true,
        "inline":   false,
        "modphase": true,
        "sanity": true,
        "sanity_setup":{
            "do_each": 100,
            "mode": "simple",
            "verbose": 3,
            "metrics": {
                "gradients": true,
                "sampling":  true,
                "phase":     true
            }
        }
            
    },

    "explore_mode": true,

    "sampler":{
        "sampler":{
            "rules": ["LocalRule", "Exchange"],
            "prules": [0.5, 0.5]
        },
        "n_ranks": 1,
        "n_chains_per_rank": 32,
        "n_samples_per_chain": 64,
        "chunk_sampler": null,
        "chunk_vstate": 512
    },

    "split_training": true,

    "normal_schedule":{
        "lr_name": "warmup_exponential_decay",

        "setup":{
            "total_epochs": 1000
        },

        "lr_schedules":{
            "warmup_exponential_decay":{
                "lr0": 0.001,                 
                "peak_value": 0.02,
                "warmup_steps": 50,
                "decay_rate": 0.992
            },

            "exp_cos_schedule":{
                "lr0":0.3,          
                "decay_exp":1.0,
                "cosine_cycles": 2,
                "n":0.05,
                "lr_min": 0.005
            }
        }
    },

    "ST_schedule":{
        "epochs_struct":[
            [ 
                [100, 200, 500]
            ]
        ],

        "modes_struct":[
            [ 
                [[0], [0], ["A"]]
            ]
        ],
        "lr_struct":[

            [  
                [["lin(0.00001,0.01)"], ["exp(0.01,0.0001"], [0.001,0.005]]
            ]
        ],
        "repeat":[],
        "rescale": 1.0
}

}


