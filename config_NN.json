        "Liang_MLPMarshall":{

            "module": "SplitTraining",
            "setup":{

                "modulus_setup":{
                    "module":"CNNLiang",
                    "setup":{
                        "M1_channels": [12, 6, 6, 6, 6, 6],
                        "M2_channels": [6, 6, 6, 6, 6, 1],
                        "kernel": [[3, 3],[3, 3],[3, 3],[3, 3],[3, 3],[3, 3]],
