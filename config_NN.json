{
    "NN": {
        
        "selection": "CNN_Marshall",

        "CNN_Marshall":{

            "module": "SplitTraining",
            "setup":{

                "modulus_setup":{
                    "module":"CNN",
                    "setup":{
                        "channels":[32, 16, 8, 4],
                        "strides":[[1,1],[1,1],[1,1],[1,1]],
                        "kernel":[3,3],
                        "use_pooling":false,
                        "pooling_strides":[[1,1],[1,1],[1,1],[1,1]],
                        "final_architecture":[1]
                    }
                },
                    
                "phase_setup":{
                    "module":"MarshallSign",
                    "setup":{
                        "radians":true
                    }
                },
                
            "symm_Z2": true,
            "trivial_Z2": true,
            "symm_2D": false,
            "irrep": [2, 2],
            "use_anchor": true,
            "squeeze":true
            }
        },
        
        "ViT2D_MLP":{

            "module": "SplitTraining",
            "setup":{

                "modulus_setup":{
                    "module":"ViT2D",
                    "setup": {
                        "token_size": [2, 1],
                        "embedding_d": 64,
                        "n_heads": 4,
                        "n_blocks": 2,
                        "n_ffn_layers": 2,
                        "final_architecture": [64, 5]
                    }
                },
                
                "phase_setup":{
                    "module":"MLP",
                    "setup":{
                        "hidden_alpha": [4, 2, 2, 1],
                        "activation": ["swish","swish","swish","swish"],
                        "final_architecture": [1]
                    }
                },
                
            "symm_Z2": true,
            "trivial_Z2": true,
            "symm_2D": true,
            "irrep": [2, 2],
            "use_anchor": true,
            "squeeze":true
            }
        },

