{

    "write_folder_sim":"/home/ihuarte/Escritorio/Ivan/NNs/Simulations/",

    "sz_total": null,
    "vmc_sr":false,

    "callback":{
        "keeper": true,
        "energy_plot": false,
        "modphase": false,
        "sanity": false,
        "checkpoint":false,
        
        "keeper_setup":{
            "baseline": 1e-8,
            "mode": "best_energy"
        },   
        "energy_plot_setup":{
            "savefig": true
        },

        "modphase_setup": {
            "plot_each": 10,
            "no_null_mod": false,
            "logscale": false,
            "savefig": true
        },
        "sanity_setup":{
            "do_each": 1,
            "mode": "rich",
            "verbose": 3,
            "metrics": {
                "gradients": false,
                "sampling":  true,
                "sample_histogram": true,
                "phase":     false
            }
        },
        "checkpoint_setup":{
            "do_each":100,
            "async": false
        }
            
    },

    "sampler":{
        "sampler":{
            "rules": ["Exchange", "LocalRule"],
            "prules": [0.7, 0.3],
            "initial_state": "hilbert"
        },
        "n_chains_per_rank": 4096,
        "n_samples_per_chain": 1,
        "chunk_sampler": null,
        "chunk_vstate": 4096
    },


    "schedule":{

        "learning_rate":{
            "epochs_struct":[
                
                [ 
                    [1000, 500]
                ]
                
            ],

            "modes_struct":[
                
                [
                    [["A"], ["A"]]
                ]
                
            ],
            "lr_struct":[
                
                [
                    [ [0.05], ["exp(0.005, 0.00001)"]]
                ]
                
            ],
            "repeat":[], 
            "rescale": 1.0
        },
        
        "sampler":{

        }

    }

}
