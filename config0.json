{

    "write_folder_sim":"/home/ihuarte/Escritorio/Ivan/NNs/Simulations_irreps_Clip/",

    "sz_total": null,
    "vmc_sr": true,

    "callback":{
        "keeper": true,
        "energy_plot": false,
        "modphase": false,
        "sanity": false,
        "leaves_gradient": true,
        "checkpoint":false,
        
        "keeper_setup":{
            "baseline": 1e-8,
            "mode": "best_energy"
        },   
        "energy_plot_setup":{
            "savefig": true
        },

        "modphase_setup": {
            "plot_each": 10,
            "no_null_mod": false,
            "logscale": false,
            "savefig": true
        },
        "sanity_setup":{
            "do_each": 10,
            "mode": "simple",
            "verbose": 3,
            "metrics": {
                "gradients": true,
                "sampling":  false,
                "sample_histogram": false,
                "phase":     false
            }
        },
        "leaves_gradient_setup":{
            "do_each": 1,
            "metrics": "mean|std|max|min",
            "show_parameters": true
        },
        "checkpoint_setup":{
            "do_each":100,
            "async": false
        }
            
    },

    "sampler":{
        "sampler":{
            "rules": ["LocalRule", "Exchange"],
            "prules": [0.5, 0.5],
            "initial_state": "M0"
        },
        "n_chains_per_rank": 1024,
        "n_samples_per_chain": 1,
        "chunk_sampler": null,
        "chunk_vstate": 1024
    },


    "schedule":{

        "learning_rate":{
            "epochs_struct":[
                
                [ 
                    [200, 100, 400, 100, 300]
                ]
                
            ],

            "modes_struct":[
                
                [
                    [["A"], ["A"], ["A"], ["A"], ["A"]]
                ]
                
            ],
            "lr_struct":[
                
                [
                    [  ["lin(0.001, 0.005)"], [0.005], ["exp(0.005, 0.0005)"], ["lin(0.0005, 0.0001)"]]
                ]
                
            ],
            "repeat":[], 
            "rescale": 1.0
        },
        
        "sampler":{

        }

    }

}
