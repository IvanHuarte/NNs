{

    "write_folder_sim":"/home/ihuarte/Escritorio/Ivan/NNs/prueba_depthwiseconv/",

    "sz_total": 0,

    "callback":{
        "keeper": true,
        "energy_plot": false,
        "modphase": false,
        "sanity": false,
        "leaves_gradient": false,
        "checkpoint": false,
        
        "keeper_setup": {
            "mode": ["best", "best_energy", "best_vscore"],
            "orbax": true,
            "save_every": 50,
            "vscore_max": 0.05,
            "best_setup": {"c": 8.0}
        },

        "energy_plot_setup":{
            "savefig": true
        },

        "modphase_setup": {
            "plot_each": 10,
            "no_null_mod": false,
            "logscale": false,
            "savefig": true
        },
        "sanity_setup":{
            "do_each": 10,
            "mode": "simple",
            "verbose": 3,
            "metrics": {
                "gradients": true,
                "sampling":  false,
                "sample_histogram": false,
                "phase":     false
            }
        },
        "leaves_gradient_setup":{
            "do_each": 1,
            "metrics": "mean|std|max|min",
            "show_parameters": true
        },
        "checkpoint_setup":{
            "do_each":50,
            "async": false
        }
            
    },

    "sampler":{
        "selection": "metropolis",

        "metropolis":{
            "sampler":{
                "rules": ["Exchange"],
                "prules": [0.5, 0.5],
                "initial_state": "hilbert"
            },
            "n_chains_per_rank": 64,
            "n_samples_per_chain": 32
        },

        "nkARSampler":{

        },
        "n_chains_per_rank": 64,
        "n_samples_per_chain": 32,
        "chunk_sampler": null,
        "chunk_vstate": 1024
        
    },

    "optimizer":{
        "optimizer": "sgd",
        "modifications":{
            "clip": null,
            "clip_by_block_rms": null,
            "scale": null,
            "scale_by_rms": null,
            "scale_by_learning_rate": null,
            "add_noise": null,
            "trace": null,
            "clip_by_global_norm": null
        }
    },

    "VMC": {
        "selection": "vmc_sr_netket",
        "vmc_netket": {
            "SR": true,
            "solver": "cg"
        },
        "vmc_sr_netket": {
            "mode": "complex",
            "linear_solver": "cholesky_with_fallback",
            "chunk_size_bwd": null
        }
    },


    "schedule":{

        "learning_rate":{
            "epochs_struct":[
                
                [ 
                    [500]
                ]
                
            ],

            "modes_struct":[
                
                [
                    [ ["A"] ]
                ]
                
            ],
            "lr_struct":[
                
                [
                    [ [0.01] ]
                ]
                
            ],
            "rescale": 1.0
        },
        
        "sampler":{},


        "diag_shift": "lin(0.0001,0.0001,300)"

    }

}
