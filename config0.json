{

    "write_folder_sim":"/home/ihuarte/Escritorio/Ivan/NNs/Simulations_irreps/CvT/J1J2Square/8x8/",

    "sz_total": 0,

    "callback":{
        "keeper": true,
        "energy_plot": false,
        "modphase": false,
        "sanity": false,
        "leaves_gradient": false,
        "checkpoint":false,
        
        "keeper_setup":{
            "baseline": 1e-30,
            "mode": "best_vscore"
        },   
        "energy_plot_setup":{
            "savefig": true
        },

        "modphase_setup": {
            "plot_each": 10,
            "no_null_mod": false,
            "logscale": false,
            "savefig": true
        },
        "sanity_setup":{
            "do_each": 10,
            "mode": "simple",
            "verbose": 3,
            "metrics": {
                "gradients": true,
                "sampling":  false,
                "sample_histogram": false,
                "phase":     false
            }
        },
        "leaves_gradient_setup":{
            "do_each": 1,
            "metrics": "mean|std|max|min",
            "show_parameters": true
        },
        "checkpoint_setup":{
            "do_each":100,
            "async": false
        }
            
    },

    "sampler":{
        "sampler":{
            "rules": ["Exchange"],
            "prules": [0.7, 0.3],
            "initial_state": "hilbert"
        },
        "n_chains_per_rank": 2048,
        "n_samples_per_chain": 1,
        "chunk_sampler": null,
        "chunk_vstate": 2048
    },

    "optimizer":{
        "optimizer": "sgd",
        "modifications":{
            "clip": null,
            "clip_by_block_rms": null,
            "scale": null,
            "scale_by_rms": null,
            "scale_by_learning_rate": null,
            "add_noise": null,
            "trace": null,
            "clip_by_global_norm": null
        }
    },

    "VMC": {
        "selection": "vmc_netket",
        "vmc_netket": {
            "SR": true,
            "solver": "cg"
        },
        "vmc_sr_netket": {
            "mode": "complex",
            "linear_solver": "cholesky_with_fallback"
        }
    },


    "schedule":{

        "learning_rate":{
            "epochs_struct":[
                
                [ 
                    [300, 100, 100]
                ]
                
            ],

            "modes_struct":[
                
                [
                    [["A"], ["A"], ["A"]]
                ]
                
            ],
            "lr_struct":[
                
                [
                    [ [0.01], ["exp(0.01, 0.0005)"], [0.0001] ]
                ]
                
            ],
            "repeat":[], 
            "rescale": 1.0
        },
        
        "sampler":{

        },

        "diag_shift": "lin(0.0001,0.0001)"

    }

}
